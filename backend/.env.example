# ---- Database ----
DB_PATH=./data_guru.db

# ---- Live data (optional) ----
# Free key: https://data.gov.in -> My Account -> API key
DATA_GOV_API_KEY=

# ---- LLM (optional; without it the rule engine answers) ----
# provider: openai | groq | together | openrouter | ollama | gemini
# For Groq: free key at https://console.groq.com/keys
# For OpenAI: https://platform.openai.com/api-keys
# For Ollama: no key needed (runs locally)
LLM_PROVIDER=groq
LLM_API_KEY=
# Override only if you use a custom OpenAI-compatible endpoint:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=openai/gpt-oss-120b
# Set to false to keep the built-in answer sentence instead of an LLM summary:
LLM_SUMMARY=true

# ---- Speech-to-Text (Groq Whisper; uses LLM_API_KEY by default) ----
# Get a Groq key: https://console.groq.com/keys
# STT_MODEL=whisper-large-v3-turbo
